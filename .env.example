NEXT_PUBLIC_SITE_URL=https://www.hiltonahead.com

# ——— Email (Resend) — transactional itinerary + newsletter notifications ———
# Sign up at resend.com, create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. Until you verify a custom domain, use:
#   "Hilton Ahead <onboarding@resend.dev>"
# Once hello@hiltonahead.com is verified in Resend, switch to that.
RESEND_FROM_EMAIL=
# Where itinerary notifications go.
RESEND_TO_EMAIL=hiltonahead@gmail.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stripe (server-only). Use test key (sk_test_...) until ready for live payments.
STRIPE_SECRET_KEY=
# Optional — Stripe publishable key if you add Elements client-side later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Google Search Console HTML-tag verification. Paste the content value
# (just the token, not the full tag) once you verify the property.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Search Console HTML-FILE verification (alternate method).
# Set to the filename token Google gave you, WITHOUT the .html extension,
# e.g. `google741f91a51ccaff7d`. The site will serve the verification
# content dynamically at /<token>.html. Leave blank if using the meta-tag method.
GOOGLE_SITE_VERIFICATION_FILE=
