NEXT_PUBLIC_SITE_URL=https://www.hiltonahead.com

# ——— Email (Resend) — transactional itinerary + newsletter notifications ———
# Sign up at resend.com, create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. Until you verify a custom domain, use:
#   "Hilton Ahead <onboarding@resend.dev>"
# Once hello@hiltonahead.com is verified in Resend, switch to that.
RESEND_FROM_EMAIL=
# Where itinerary notifications go.
RESEND_TO_EMAIL=hiltonahead@gmail.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stripe (server-only). Use test key (sk_test_...) until ready for live payments.
STRIPE_SECRET_KEY=
# Optional — Stripe publishable key if you add Elements client-side later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret — Stripe dashboard → Webhooks → your endpoint → Reveal signing secret.
# Required for /api/stripe/webhook to verify event authenticity.
STRIPE_WEBHOOK_SECRET=
# ——— Stripe Price IDs ———
# Create products + prices in Stripe dashboard (Products → Add product).
# One-time SKUs (Compass, Charter) work without a Price ID via inline price_data,
# but all subscription tiers REQUIRE a configured Price ID to check out.
# Paste the price_XXXX value from each price's detail page.
#
# B2C — one-time
STRIPE_PRICE_COMPASS=
STRIPE_PRICE_CHARTER_RETAINER=
STRIPE_PRICE_HERITAGE_KIT_VIP=
# B2C — subscriptions (Insider Club)
STRIPE_PRICE_INSIDER_CLUB_MONTHLY=
STRIPE_PRICE_INSIDER_CLUB_YEARLY=
# B2B — directory subscriptions (yearly, includes 14-day trial)
STRIPE_PRICE_LISTED_YEARLY=
STRIPE_PRICE_FEATURED_YEARLY=
# B2B-Ads — display ad slots
STRIPE_PRICE_FEATURED_PIN_MONTHLY=
STRIPE_PRICE_PAGE_DISPLAY_MONTHLY=
STRIPE_PRICE_STORY_SPONSOR=
STRIPE_PRICE_FEATURED_VILLA_MONTHLY=
# Workstream E — info product Stripe Price IDs (one-time, $49 each)
STRIPE_PRICE_ITINERARY_PACK_COUPLES=
STRIPE_PRICE_ITINERARY_PACK_GOLF=
# Workstream E — PDF download URLs (set when real PDFs are ready)
# Can be any publicly accessible URL: Vercel Blob, S3, Google Drive direct link, etc.
DOWNLOAD_URL_ITINERARY_PACK_COUPLES=
DOWNLOAD_URL_ITINERARY_PACK_GOLF=
# Google Search Console HTML-tag verification. Paste the content value
# (just the token, not the full tag) once you verify the property.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Search Console HTML-FILE verification (alternate method).
# Set to the filename token Google gave you, WITHOUT the .html extension,
# e.g. `google741f91a51ccaff7d`. The site will serve the verification
# content dynamically at /<token>.html. Leave blank if using the meta-tag method.
GOOGLE_SITE_VERIFICATION_FILE=

# ——— Google OAuth (admin sign-in + Gmail API + Calendar API) ———
# From Google Cloud Console → APIs & Services → Credentials → your
# OAuth 2.0 Client ID. Must match the Client ID + Secret pasted into
# Supabase's Google provider. Server-only; never expose to browser.
# Scopes requested: gmail.readonly, gmail.send, calendar.readonly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ——— Calendly (webhook + one-time setup script) ———
# Personal Access Token for scripts/calendly-register-webhook.ts.
# Generate at https://calendly.com/integrations/api_webhooks
CALENDLY_PERSONAL_ACCESS_TOKEN=
# Organization URI from https://api.calendly.com/users/me
# (response.resource.current_organization)
CALENDLY_ORGANIZATION_URI=
# Signing key returned by Calendly when the webhook subscription is
# created. Used by /api/calendly/webhook to verify HMAC signatures.
CALENDLY_WEBHOOK_SIGNING_KEY=

# ——— Sales / Outbound CRM (migration 018_sales_prospects.sql) ———
# HMAC secret for one-click unsubscribe tokens at /api/sales-unsubscribe.
# 32+ random bytes. Generate: `openssl rand -hex 32`. Server-only.
UNSUBSCRIBE_HMAC_SECRET=
# Salt for hashing prospect IPs in sales_touches metadata. 32+ random bytes.
# Generate: `openssl rand -hex 32`. Server-only.
SALES_IP_SALT=
# Bearer token for the cron route /api/cron/sales-sequence-tick.
# Set in your scheduler (Vercel Cron / GitHub Actions / external). Server-only.
# Generate: `openssl rand -hex 32`.
CRON_SECRET=

# ——— Backlink outreach email engine (migration 023_outreach_email_engine.sql) ———
# HMAC secret for signing open/click tracking URLs embedded in outbound
# outreach HTML emails. Without this, anyone with a URL guess can inject
# fake events into outreach_email_events.
# Falls back to OUTREACH_UNSUBSCRIBE_SECRET, then a dev-only fallback.
# Generate: `openssl rand -hex 32`. Server-only.
OUTREACH_TRACKING_SECRET=
# HMAC secret for one-click unsubscribe tokens in outreach email footers.
# Required for backlink outreach (the CAN-SPAM compliance footer).
# Generate: `openssl rand -hex 32`. Server-only.
OUTREACH_UNSUBSCRIBE_SECRET=
# Display name on outreach From: header.
OUTREACH_FROM_NAME=Hilton Ahead
# Physical mailing address — required by CAN-SPAM § 5(a)(5).
# A PO box is acceptable. Used in the email footer.
OUTREACH_FROM_ADDRESS="Hilton Ahead, Hilton Head Island, SC 29928"

# ——— Affiliate program tracking IDs ———
# Server-only. Read by app/lib/affiliates.ts → withAffiliateParams() and
# stamped onto outbound links from <AffiliateCard> / <AffiliateLink>.
# Until each is set, the helper passes raw URLs through (links work, but
# you earn $0). Apply to each program, paste IDs here + in Vercel.
#
# Booking.com — Partner Hub (https://partner.booking.com). Look for "AID".
AFFILIATE_BOOKING_AID=
# Expedia Group — Partnerize (https://expedia.partnerize.com). Use your Partnerize
# Publisher ID. Format like "1110l31904". Links are wrapped via prf.hn redirect
# (see linkPattern: 'partnerize-wrap' in data/affiliateLinks.ts), not query-stamped.
AFFILIATE_EXPEDIA_CAMREF=
# Vrbo — same Partnerize publisher ID as Expedia (both are Expedia Group
# campaigns). Kept as a separate env var only in case the networks split.
AFFILIATE_VRBO_CAMREF=
# Viator (Tripadvisor) — Partner program (https://www.viatoraffiliate.com). "pid".
AFFILIATE_VIATOR_PID=
# GetYourGuide — Partner program (https://partner.getyourguide.com). "partner_id".
AFFILIATE_GETYOURGUIDE_PARTNER_ID=
# GolfNow — via Impact Radius (https://www.golfnow.com/affiliates). "camref".
AFFILIATE_GOLFNOW_CAMREF=
# Amazon Associates — (https://affiliate-program.amazon.com). Tracking-ID "tag".
# Set the base tag with your default Store ID (e.g. 12189000-20). All Amazon
# links fall back to this if no placement-specific tag is configured.
AFFILIATE_AMAZON_TAG=
# Per-surface Amazon tracking IDs (optional). Create additional tracking IDs
# in Associates Central → Manage Your Tracking IDs, then map them here. The
# helper picks the right one based on the `placement` prop passed to
# <AffiliateCard placement="blog/...">. Prefix match is case-insensitive.
# All roll up to the same Associates account — purely for per-surface
# attribution in Amazon's reports.
AFFILIATE_AMAZON_TAG_BLOG=
AFFILIATE_AMAZON_TAG_FAQ=
AFFILIATE_AMAZON_TAG_LOCAL=
AFFILIATE_AMAZON_TAG_NEWSLETTER=
AFFILIATE_AMAZON_TAG_TRIP=
# Marriott Bonvoy — via Impact Radius (https://app.impact.com). Set to the
# camref / SubID once Marriott approves your application. Until then, links
# point to marriott.com without tracking — they still work, they just don't
# earn commission.
AFFILIATE_MARRIOTT_AID=
# Allianz Travel Insurance — via Impact Radius. Universal trip-insurance
# attach. Set the camref once Allianz approves the application.
AFFILIATE_ALLIANZ_CAMREF=
# Hertz — via Impact Radius. Car rental from SAV / HHH airports. Set the
# camref once Hertz approves.
AFFILIATE_HERTZ_CAMREF=
# Peter Millar — via Impact Radius. Official RBC Heritage apparel partner.
# Set the camref once Peter Millar approves.
AFFILIATE_PETERMILLAR_CAMREF=
# Southwest Airlines (Rapid Rewards / Points.com) — via Impact. This program
# uses linkPattern 'prebuilt-link': paste the COMPLETE vanity tracking link
# generated by Impact's "Create a link" tool (e.g. https://swa.eyjo.net/...),
# not an ID. The committed defaultDeeplink already carries the current link, so
# this override is only needed to rotate it. NOTE: the program pays on Rapid
# Rewards points purchases, not flight bookings — point the Impact link at the
# "Buy Points" flow.
AFFILIATE_SOUTHWEST_LINK=
# Hilton Honors — via Impact. Also linkPattern 'prebuilt-link': paste the
# COMPLETE Impact vanity tracking link (e.g. https://hilton.ijrn.net/...). The
# committed defaultDeeplink carries the current link, so this override is only
# needed to rotate it. Ideally point the Impact link at the Hilton Head Island
# search results; per-property links require a separate Impact link per hotel.
AFFILIATE_HILTON_LINK=
